@import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap');
:root{font-family:Nunito,system-ui,sans-serif;color:#302b3b;background:#f7f4ff;font-synthesis:none;text-rendering:optimizeLegibility}
*{box-sizing:border-box}body{margin:0;min-width:320px;background:linear-gradient(180deg,#f7f4ff 0%,#fffafd 55%,#f8f6ff 100%);min-height:100vh}
button,input{font:inherit}button{cursor:pointer}.app-shell{max-width:760px;margin:0 auto;min-height:100vh;padding:env(safe-area-inset-top) 16px env(safe-area-inset-bottom)}
.topbar{height:62px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e9e3f1}.brand{display:flex;align-items:center;gap:9px;font-weight:800;font-size:17px}.brand-mark{display:grid;place-items:center;width:30px;height:30px;border-radius:11px;background:#e9defe;color:#8055bd}
.icon-button{border:0;background:#eee8f7;color:#655778;width:38px;height:38px;border-radius:13px;display:grid;place-items:center}
.content{padding:22px 0 36px}.welcome{margin:9px 0 23px}.eyebrow{font-size:10px;letter-spacing:1.6px;color:#9a7dbb;font-weight:800;margin:0 0 7px}.welcome h1,.section-heading h1,.detail-card h1{font-size:27px;line-height:1.2;margin:0;font-weight:800}.welcome p:last-child{color:#847b90;font-size:13px;margin:8px 0 0}
.section-grid{display:grid;grid-template-columns:1fr;gap:10px}.section-tile-wrap{position:relative}.section-tile{width:100%;border:1px solid #ece5f4;background:rgba(255,255,255,.82);border-radius:17px;padding:15px;display:flex;align-items:center;gap:13px;text-align:left;color:#383143;box-shadow:0 3px 12px rgba(80,54,110,.035);min-height:62px}.section-tile:active,.character-row:active{transform:scale(.99)}.tile-number{font-size:11px;color:#a58abf;font-weight:800;background:#f3edfb;border-radius:9px;padding:6px 7px}.tile-name{font-size:14px;font-weight:800;flex:1}.section-tile svg{color:#b2a3c2}.tile-tools{display:flex;gap:5px;position:absolute;right:48px;top:50%;transform:translateY(-50%)}.tile-tools button{border:0;background:#f3eef8;color:#8a7b9b;border-radius:8px;width:27px;height:27px;display:grid;place-items:center}
.back{border:0;background:transparent;color:#8465a5;display:flex;align-items:center;gap:7px;font-weight:800;font-size:13px;padding:5px 0 19px}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:10px;margin-bottom:17px}.section-heading h1{font-size:24px}.primary-button,.secondary-button,.danger-button{border:0;border-radius:12px;padding:12px 15px;font-weight:800;display:inline-flex;align-items:center;justify-content:center;gap:7px}.primary-button{background:#8059b5;color:white}.primary-button.compact{padding:10px 12px;font-size:12px}.primary-button.full{width:100%;margin-top:12px}.secondary-button{background:#eee8f7;color:#71568f}.danger-button{background:#fff0f0;color:#b34d60}
.search{height:45px;border:1px solid #e9e2f1;border-radius:13px;background:white;display:flex;align-items:center;gap:9px;padding:0 13px;color:#9a8ca9;margin-bottom:15px}.search input{border:0;outline:0;background:transparent;width:100%;color:#393142;font-size:13px}
.character-list{display:flex;flex-direction:column;gap:8px}.character-row{border:1px solid #eee8f3;border-radius:14px;background:white;padding:9px 12px;display:flex;align-items:center;gap:12px;text-align:left;color:#393142;font-weight:800;font-size:14px;min-height:59px}.character-row img,.avatar-placeholder{width:40px;height:40px;border-radius:11px;object-fit:cover;background:#f1eafb}.avatar-placeholder{display:grid;place-items:center;color:#9874bd}.character-row span:nth-child(2){flex:1}.character-row svg{color:#b4a6c3}
.empty-state{border:1px dashed #dcd1e9;border-radius:17px;padding:30px 18px;display:flex;align-items:center;flex-direction:column;gap:8px;text-align:center;color:#9a8eaa}.empty-state b{color:#62566f}.empty-state span{font-size:12px;max-width:250px}.detail-card{background:white;border:1px solid #eee7f3;border-radius:20px;padding:13px;box-shadow:0 5px 20px rgba(70,50,90,.05)}.detail-image{width:100%;max-height:70vh;object-fit:contain;border-radius:13px;background:#faf8fc}.detail-card h1{font-size:22px;margin:15px 3px}.empty-image{background:#f5f0fa;border-radius:14px;color:#a38bb9;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:8px}.empty-image.large{height:240px}.empty-image span{font-size:12px}.admin-actions{display:flex;gap:8px;margin-top:10px}.admin-actions button{flex:1;font-size:12px}
.admin-strip{display:flex;justify-content:space-between;align-items:center;background:#eee7f8;color:#76569a;border-radius:12px;padding:10px 12px;margin-bottom:10px;font-size:12px;font-weight:800}.admin-strip button{border:0;background:transparent;color:#76569a;display:flex;align-items:center;gap:5px;font-weight:800}.add-section{width:100%;border:1px dashed #bda8d3;background:#faf7ff;color:#8059b5;border-radius:13px;padding:12px;margin-bottom:12px;display:flex;align-items:center;justify-content:center;gap:7px;font-weight:800}
.notice,.setup-banner{border-radius:12px;padding:11px 13px;margin-top:12px;font-size:12px}.notice{background:#fff0f0;color:#a34658;display:flex;justify-content:space-between}.setup-banner{background:#fff8e9;color:#80663c;display:flex;flex-direction:column;gap:4px}.setup-banner span{line-height:1.4}.loading{font-size:12px;color:#93869f;text-align:center}
footer{text-align:center;padding:20px 0 25px;color:#b0a5ba;font-size:10px}footer span{color:#9b75c4}
.modal-backdrop{position:fixed;inset:0;background:rgba(39,28,50,.35);display:flex;align-items:flex-end;justify-content:center;padding:12px;z-index:20}.modal{background:#fff;border-radius:22px;padding:18px;width:100%;max-width:480px;box-shadow:0 10px 40px #35234430}.modal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}.modal-head h2{font-size:18px;margin:0}.field{display:flex;flex-direction:column;gap:7px;color:#776a83;font-size:12px;font-weight:800;margin:12px 0}.field input{border:1px solid #e7dfef;border-radius:12px;padding:12px;color:#352d40;outline-color:#a98acb}.muted{font-size:13px;color:#83788e}.upload-box{position:relative;border:1px dashed #cbb9dc;border-radius:14px;background:#faf7ff;padding:20px;display:flex;align-items:center;flex-direction:column;gap:5px;color:#8b6bad;font-size:12px;overflow:hidden}.upload-box span{color:#a59aaa}.upload-box input{position:absolute;inset:0;opacity:0;width:100%;height:100%;cursor:pointer}.upload-preview{width:100%;max-height:180px;object-fit:contain;margin-top:12px;border-radius:12px}
@media(min-width:560px){.section-grid{grid-template-columns:1fr 1fr}.app-shell{padding-left:24px;padding-right:24px}.modal-backdrop{align-items:center}}
